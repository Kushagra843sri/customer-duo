# Public, client-facing configuration only. Anything prefixed EXPO_PUBLIC_ is
# bundled into the app and visible to users - never put server secrets here.
# Copy to .env.local (gitignored); never commit real values.

# DEVELOPMENT-ONLY UI PREVIEW: set to 1 to browse every screen with built-in
# sample data - no Firebase, no backend, no sign-in. Ignored in production
# builds, shows a PREVIEW banner, saves nothing to a server.
# EXPO_PUBLIC_UI_PREVIEW=1

# Duo-Face API base URL (required for production builds). In development on a
# physical phone leave unset: the app then uses the Expo dev-server machine on
# EXPO_PUBLIC_API_PORT (default 4000). Never commit a personal IP.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
# EXPO_PUBLIC_API_PORT=4000

# Firebase *web app* config for the SAME Firebase project the server verifies
# tokens for (server FIREBASE_PROJECT_ID). Client-safe identifiers, not secrets.
# Enable "Email/Password" under Authentication > Sign-in method.
# NEVER put a service account, private key or Admin credential here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Build-time (NOT EXPO_PUBLIC_), read by app.config.js - never committed:
# Google Maps SDK key for the Android live-tracking map (restrict it in Google Cloud
# to this app's package name + signing SHA-1 and the Maps SDK for Android).
GOOGLE_MAPS_ANDROID_API_KEY=
# Path to the Firebase google-services.json, required for push notifications on Android builds.
GOOGLE_SERVICES_JSON=
