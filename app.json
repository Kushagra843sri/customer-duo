{
  "expo": {
    "name": "Allz Bharat",
    "slug": "allz-bharat-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "allzbharat",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.duoface.customer",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": { "bundleIdentifier": "com.duoface.customer" },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Allz Bharat uses your location to fill in your delivery address." }
      ],
      ["expo-splash-screen", { "backgroundColor": "#EA580C", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
